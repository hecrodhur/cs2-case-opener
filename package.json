{
  "name": "cs2-case-opener",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
