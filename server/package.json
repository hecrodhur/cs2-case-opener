{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --import tsx --test src/test/rng.test.ts src/test/api.test.ts src/test/overhaul.test.ts src/test/pricing.test.ts src/test/variants.test.ts",
    "test:rng": "node --import tsx --test src/test/rng.test.ts",
    "db:init": "node --import tsx src/cli/migrate.ts",
    "sync": "node --import tsx src/cli/sync.ts"
  },
  "dependencies": {
    "shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
